name: giftwrap
env:
  foo: bar
  whatnot: This is a long string
include:
  - LICENSE
exec:
  pre:
    - echo "pre-exec global"
  post:
    - echo "post-exec global"
    - echo "$foo is foo"
targets:
  default:
    env:
      foo: "asdfasdf"
    package: github.com/indrora/giftwrap
    targets:
    - linux/arm64
    - linux/amd64
    - darwin/arm64
    - darwin/amd64
    - windows/arm64
    - windows/amd64
    exec:
      pre:
        - echo "pre-exec for target, building $GOOS + $GOARCH"
        - echo "$whatnot"
      post:
        - echo "post-exec for target"
        - echo "foo is $foo and whatnot is $whatnot"
